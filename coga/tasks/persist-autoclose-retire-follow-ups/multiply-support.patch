@@ -0,0 +1,186 @@
+import subprocess
+import tempfile
+import unittest
+from pathlib import Path
+
+
+REPO_ROOT = Path(__file__).resolve().parents[1]
+FOLLOW_UPS_SCRIPT = REPO_ROOT / "scripts" / "coga-retire-followups.py"
+RETIRES_LIST = REPO_ROOT / "coga" / "recurring" / "autoclose-merged" / "retires.md"
+PERIOD_TASK_DIR = REPO_ROOT / "coga" / "tasks" / "recurring" / "autoclose-merged"
+OPEN_HEADING = "## Follow-ups (open)"
+
+
+class RetireFollowUpsTest(unittest.TestCase):
+    def setUp(self):
+        self.temporary_directory = tempfile.TemporaryDirectory(
+            prefix="multiply retire follow ups fixture "
+        )
+        self.root = Path(self.temporary_directory.name)
+        self.coga = self.root / "coga"
+        self.list_file = self.coga / "recurring" / "autoclose-merged" / "retires.md"
+        self.period_task = self.coga / "tasks" / "recurring" / "autoclose-merged"
+        self.period_task.mkdir(parents=True)
+        (self.period_task / "ticket.md").write_text(
+            "period task blackboard\n", encoding="utf-8"
+        )
+        self.worktree = self.root / "live worktree"
+
+    def tearDown(self):
+        self.temporary_directory.cleanup()
+
+    def run_script(self, *arguments):
+        return subprocess.run(
+            [str(FOLLOW_UPS_SCRIPT), "--file", str(self.list_file), *arguments],
+            cwd=REPO_ROOT,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            check=False,
+        )
+
+    def add(self, slug, branch="", worktree=""):
+        result = self.run_script(
+            "add",
+            "--slug",
+            slug,
+            "--branch",
+            branch,
+            "--worktree",
+            worktree,
+            "--recorded",
+            "2026-09-04",
+        )
+        self.assertEqual(result.returncode, 0, result.stderr.decode())
+        return result.stdout.decode().strip()
+
+    def make_repo_holding_branch(self, branch):
+        repo = self.root / "repo"
+        repo.mkdir()
+        for command in (
+            ["git", "init", "--quiet"],
+            ["git", "config", "user.email", "test@example.com"],
+            ["git", "config", "user.name", "test"],
+            ["git", "commit", "--quiet", "--allow-empty", "-m", "root"],
+            ["git", "branch", branch],
+        ):
+            subprocess.run(command, cwd=repo, check=True, stdout=subprocess.DEVNULL)
+        return repo
+
+    def test_period_task_deletion_leaves_the_follow_up_list_intact(self):
+        self.add("v1/stranded", "codex/stranded", str(self.worktree))
+        # A period boundary deletes the whole prior-period task directory.
+        for path in sorted(self.period_task.rglob("*"), reverse=True):
+            path.unlink()
+        self.period_task.rmdir()
+
+        self.assertFalse(self.period_task.exists())
+        listed = self.run_script("list")
+        self.assertEqual(listed.returncode, 0, listed.stderr.decode())
+        self.assertEqual(listed.stdout.decode().strip(), "coga retire v1/stranded")
+
+    def test_the_durable_list_lives_outside_the_period_task_tree(self):
+        self.assertTrue(RETIRES_LIST.is_file())
+        self.assertFalse(
+            RETIRES_LIST.is_relative_to(REPO_ROOT / "coga" / "tasks"),
+            "the follow-up list must not live under coga/tasks/",
+        )
+        self.assertNotIn(PERIOD_TASK_DIR, RETIRES_LIST.parents)
+
+    def test_recording_the_same_slug_twice_does_not_duplicate_it(self):
+        self.add("v1/stranded", "codex/stranded", str(self.worktree))
+        self.assertEqual(
+            self.add("v1/stranded", "codex/stranded", str(self.worktree)),
+            "unchanged v1/stranded",
+        )
+
+        body = self.list_file.read_text(encoding="utf-8")
+        self.assertEqual(body.count("`v1/stranded`"), 1)
+
+    def test_re_recording_a_slug_refreshes_the_checkout_it_names(self):
+        self.add("v1/stranded", "codex/old-branch", str(self.worktree))
+        self.assertEqual(
+            self.add("v1/stranded", "codex/new-branch", str(self.worktree)),
+            "updated v1/stranded",
+        )
+
+        body = self.list_file.read_text(encoding="utf-8")
+        self.assertEqual(body.count("`v1/stranded`"), 1)
+        self.assertIn("branch `codex/new-branch`", body)
+        self.assertNotIn("codex/old-branch", body)
+
+    def test_prune_drops_a_follow_up_whose_worktree_and_branch_are_gone(self):
+        self.add("v1/discharged", "codex/gone", str(self.root / "absent worktree"))
+        repo = self.make_repo_holding_branch("codex/unrelated")
+
+        result = self.run_script("prune", "--repo", str(repo))
+        self.assertEqual(result.returncode, 0, result.stderr.decode())
+        self.assertIn("dropped v1/discharged", result.stdout.decode())
+        self.assertNotIn("v1/discharged", self.list_file.read_text(encoding="utf-8"))
+
+    def test_prune_keeps_a_follow_up_whose_branch_still_exists(self):
+        self.add("v1/stranded", "codex/stranded", str(self.root / "absent worktree"))
+        repo = self.make_repo_holding_branch("codex/stranded")
+
+        result = self.run_script("prune", "--repo", str(repo))
+        self.assertEqual(result.returncode, 0, result.stderr.decode())
+        self.assertIn("1 open, 0 discharged", result.stdout.decode())
+        self.assertIn("v1/stranded", self.list_file.read_text(encoding="utf-8"))
+
+    def test_prune_keeps_a_follow_up_whose_worktree_still_exists(self):
+        self.worktree.mkdir()
+        self.add("v1/stranded", "codex/gone", str(self.worktree))
+        repo = self.make_repo_holding_branch("codex/unrelated")
+
+        result = self.run_script("prune", "--repo", str(repo))
+        self.assertEqual(result.returncode, 0, result.stderr.decode())
+        self.assertIn("1 open, 0 discharged", result.stdout.decode())
+        self.assertIn("v1/stranded", self.list_file.read_text(encoding="utf-8"))
+
+    def test_a_heading_without_a_trailing_newline_is_not_doubled(self):
+        # An editor that strips the trailing newline leaves the file ending at
+        # the heading; partitioning on a bare heading would re-append it.
+        self.list_file.parent.mkdir(parents=True, exist_ok=True)
+        self.list_file.write_text(
+            f"# Stranded follow-ups\n\n{OPEN_HEADING}", encoding="utf-8"
+        )
+
+        self.add("v1/stranded", "codex/stranded", str(self.worktree))
+
+        body = self.list_file.read_text(encoding="utf-8")
+        self.assertEqual(body.count(OPEN_HEADING), 1)
+        self.assertIn("`v1/stranded`", body)
+
+    def test_union_merged_duplicate_slugs_collapse_on_the_next_write(self):
+        # `retires.md` is merge=union, so the same slug recorded on two
+        # branches arrives as two lines.
+        self.add("v1/stranded", "codex/old-branch", str(self.worktree))
+        with self.list_file.open("a", encoding="utf-8") as handle:
+            handle.write(
+                "- `v1/stranded` — branch `codex/other-branch`, "
+                f"worktree `{self.worktree}`, recorded `2026-09-05`\n"
+            )
+
+        listed = self.run_script("list")
+        self.assertEqual(listed.returncode, 0, listed.stderr.decode())
+        self.assertEqual(listed.stdout.decode().strip(), "coga retire v1/stranded")
+
+        self.add("v1/stranded", "codex/new-branch", str(self.worktree))
+
+        body = self.list_file.read_text(encoding="utf-8")
+        self.assertEqual(body.count("`v1/stranded`"), 1)
+        self.assertIn("branch `codex/new-branch`", body)
+        # The first sighting's date survives the collapse.
+        self.assertIn("recorded `2026-09-04`", body)
+
+    def test_an_unparsable_entry_fails_loudly(self):
+        self.add("v1/stranded", "codex/stranded", str(self.worktree))
