@@ -0,0 +1,217 @@
+#!/usr/bin/env python3
+"""Maintain the durable list of stranded `coga retire` follow-ups.
+
+The autoclose sweep names a `coga retire` follow-up for every ticket it
+closes that still records a feature checkout, but it must never dispose of
+one — `coga retire` owns the worktree and branch safety proofs. This script
+owns the file those names are written to, so the worklist survives the
+period task that the next sweep deletes.
+"""
+
+import argparse
+import datetime
+import re
+import subprocess
+import sys
+from pathlib import Path
+
+
+REPO_ROOT = Path(__file__).resolve().parents[1]
+DEFAULT_LIST = REPO_ROOT / "coga" / "recurring" / "autoclose-merged" / "retires.md"
+OPEN_HEADING = "## Follow-ups (open)"
+ENTRY_PATTERN = re.compile(
+    r"^- `(?P<slug>[^`]+)` — branch `(?P<branch>[^`]*)`, "
+    r"worktree `(?P<worktree>[^`]*)`, recorded `(?P<recorded>[^`]*)`$"
+)
+FILE_HEADER = """# Stranded `coga retire` follow-ups
+
+Durable worklist of auto-closed tickets whose feature checkout still exists.
+The `autoclose-merged` sweep appends here — **not** to its period task under
+`coga/tasks/recurring/autoclose-merged/`, which the next period deletes.
+
+Every entry means the same thing: run `coga retire <slug>` to dispose of the
+recorded worktree and branch. Autoclose only ever names the follow-up; retire
+owns the safety proofs. Entries are keyed by slug, so re-recording one updates
+it rather than duplicating it, and `prune` drops an entry once both its
+worktree directory and its branch are gone.
+
+Maintained by `scripts/coga-retire-followups.py`.
+
+## Follow-ups (open)
+"""
+
+
+class FollowUpError(Exception):
+    """A diagnostic safe to print without a traceback."""
+
+
+def parse_args():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--file", type=Path, default=DEFAULT_LIST)
+    subparsers = parser.add_subparsers(dest="command", required=True)
+
+    adder = subparsers.add_parser("add", help="record a follow-up, keyed by slug")
+    adder.add_argument("--slug", required=True)
+    adder.add_argument("--branch", default="")
+    adder.add_argument("--worktree", default="")
+    adder.add_argument("--recorded", default="")
+
+    pruner = subparsers.add_parser("prune", help="drop discharged follow-ups")
+    pruner.add_argument("--repo", type=Path, default=REPO_ROOT)
+
+    subparsers.add_parser("list", help="print the open follow-ups")
+    return parser.parse_args()
+
+
+def read_entries(path):
+    """Return (header_text, entries) for an existing or absent list file."""
+    if not path.exists():
+        return FILE_HEADER, []
+    text = path.read_text(encoding="utf-8")
+    # The separator carries its newline, so that partitioning on a heading that
+    # ends the file cannot put the whole text in `header` and then re-append
+    # the heading below, silently doubling it. A stripped trailing newline is a
+    # benign thing for an editor to do, so normalize it rather than failing the
+    # sweep over it.
+    if not text.endswith("\n"):
+        text += "\n"
+    separator = OPEN_HEADING + "\n"
+    if separator not in text:
+        raise FollowUpError(f"{path} has no '{OPEN_HEADING}' section")
+    header, _, body = text.partition(separator)
+    entries = []
+    for line in body.splitlines():
+        if not line.strip():
+            continue
+        match = ENTRY_PATTERN.match(line)
+        if match is None:
+            raise FollowUpError(f"{path}: unparsable follow-up line: {line}")
+        entries.append(match.groupdict())
+    return header + separator, collapse_by_slug(entries)
+
+
+def collapse_by_slug(entries):
+    """Collapse repeated slugs, keeping the first sighting's date.
+
+    This file is `merge=union`, so a slug recorded on two branches arrives as
+    two lines. Collapsing on read applies the same rule a re-record does — the
+    later line refreshes the checkout, the first sighting's date survives — so
+    a merge artifact cannot outlive the next write.
+    """
+    by_slug = {}
+    for entry in entries:
+        existing = by_slug.get(entry["slug"])
+        by_slug[entry["slug"]] = {
+            **entry,
+            "recorded": existing["recorded"] if existing else entry["recorded"],
+        }
+    return list(by_slug.values())
+
+
+def write_entries(path, header, entries):
+    lines = [format_entry(entry) for entry in sorted(entries, key=slug_key)]
+    body = "\n".join(lines) + "\n" if lines else ""
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(header + "\n" + body, encoding="utf-8")
+
+
+def slug_key(entry):
+    return entry["slug"]
+
+
+def format_entry(entry):
+    return (
+        f"- `{entry['slug']}` — branch `{entry['branch']}`, "
+        f"worktree `{entry['worktree']}`, recorded `{entry['recorded']}`"
+    )
+
+
+def add_follow_up(path, slug, branch, worktree, recorded):
+    header, entries = read_entries(path)
+    recorded = recorded or datetime.date.today().isoformat()
+    incoming = {
+        "slug": slug,
+        "branch": branch,
+        "worktree": worktree,
+        "recorded": recorded,
+    }
+    for index, entry in enumerate(entries):
+        if entry["slug"] != slug:
+            continue
+        # Keyed by slug: refresh the checkout fields, keep the first sighting.
+        incoming["recorded"] = entry["recorded"]
+        if entry == incoming:
+            print(f"unchanged {slug}")
+            return 0
+        entries[index] = incoming
+        write_entries(path, header, entries)
+        print(f"updated {slug}")
+        return 0
+    entries.append(incoming)
+    write_entries(path, header, entries)
+    print(f"added {slug}")
+    return 0
+
+
+def live_branches(repo):
+    """Return `repo`'s local branch names, empty if it is not a usable repo.
+
+    One `for-each-ref` for the whole worklist rather than a `rev-parse` per
+    entry: the sweep prunes every entry on every run, and branch names cannot
+    contain whitespace, so a single listing answers all of them.
+    """
+    result = subprocess.run(
+        ["git", "-C", str(repo), "for-each-ref", "--format=%(refname:short)", "refs/heads/"],
+        capture_output=True,
+        text=True,
+    )
+    if result.returncode != 0:
+        return set()
+    return set(result.stdout.split())
+
+
+def prune_follow_ups(path, repo):
+    header, entries = read_entries(path)
+    branches = live_branches(repo)
+    kept = []
+    dropped = []
+    for entry in entries:
+        worktree = entry["worktree"]
+        live_worktree = bool(worktree) and Path(worktree).is_dir()
+        live_branch = bool(entry["branch"]) and entry["branch"] in branches
+        if live_worktree or live_branch:
+            kept.append(entry)
+        else:
+            dropped.append(entry)
+    if dropped:
+        write_entries(path, header, kept)
+    for entry in dropped:
+        print(f"dropped {entry['slug']}")
+    print(f"{len(kept)} open, {len(dropped)} discharged")
+    return 0
+
+
+def list_follow_ups(path):
+    _, entries = read_entries(path)
+    for entry in sorted(entries, key=slug_key):
+        print(f"coga retire {entry['slug']}")
+    return 0
+
+
+def main():
+    args = parse_args()
+    try:
+        if args.command == "add":
+            return add_follow_up(
+                args.file, args.slug, args.branch, args.worktree, args.recorded
+            )
+        if args.command == "prune":
+            return prune_follow_ups(args.file, args.repo)
+        return list_follow_ups(args.file)
+    except FollowUpError as error:
+        print(f"error: {error}", file=sys.stderr)
+        return 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
