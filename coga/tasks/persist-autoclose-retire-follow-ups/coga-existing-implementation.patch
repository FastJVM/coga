+def durable_retire_list(cfg: Config) -> Path | None:
+    """Return the recurring template's durable retire worklist, if there is one.
+
+    A recurring sweep runs under a *period* task that `coga recurring` deletes
+    at the start of the next period, so that task's blackboard cannot hold a
+    worklist — anything written there is lost at the next period boundary. The
+    template directory the period task was minted from does survive, so the
+    follow-ups belong beside its `ticket.md`.
+
+    Returns `None` for any run that is not a recurring period task, which keeps
+    the ordinary blackboard/stdout surfaces for one-off and manual runs.
+    """
+    slug = os.environ.get("COGA_TASK_SLUG") or ""
+    prefix = "recurring/"
+    if not slug.startswith(prefix):
+        return None
+    template = slug[len(prefix) :]
+    if not template or "/" in template:
+        return None
+    directory = recurring_dir(cfg) / template
+    if not directory.is_dir():
+        return None
+    return directory / RETIRE_LIST_FILENAME
+
+
+def parse_retire_list(text: str) -> tuple[str, list[dict[str, str]]]:
+    """Split a worklist into its header and its parsed entries.
+
+    A file without the heading is a corrupt or foreign worklist. We fail loudly
+    rather than silently appending a second section that no reader would find.
+    """
+    if RETIRE_LIST_HEADING not in text:
+        raise RuntimeError(f"Retire worklist has no '{RETIRE_LIST_HEADING}' section")
+    header, _, body = text.partition(RETIRE_LIST_HEADING + "\n")
+    entries: list[dict[str, str]] = []
+    for line in body.splitlines():
+        if not line.strip():
+            continue
+        match = RETIRE_LIST_ENTRY_RE.match(line)
+        if match is None:
+            raise RuntimeError(f"Unparsable retire worklist line: {line}")
+        entries.append(match.groupdict())
+    return header + RETIRE_LIST_HEADING + "\n", entries
+
+
+def render_retire_entry(entry: dict[str, str]) -> str:
+    return (
+        f"- `{entry['slug']}` — branch `{entry['branch']}`, "
+        f"worktree `{entry['worktree']}`, recorded `{entry['recorded']}`"
+    )
+
+
+def _append_retire_list(path: Path, pending: list[ClosedTicket], recorded: str) -> None:
+    """Merge this sweep's follow-ups into the durable worklist, keyed by slug.
+
+    Re-recording a slug refreshes the checkout it names and keeps the first
+    sighting's date, so a template that strands the same ticket on consecutive
+    runs accumulates one entry rather than one per run.
+    """
+    header, entries = (
+        parse_retire_list(path.read_text(encoding="utf-8"))
+        if path.exists()
+        else (RETIRE_LIST_HEADER, [])
+    )
+    by_slug = {entry["slug"]: entry for entry in entries}
+    for item in pending:
+        existing = by_slug.get(item.slug)
+        by_slug[item.slug] = {
+            "slug": item.slug,
+            "branch": item.branch or "",
+            "worktree": item.worktree or "",
+            "recorded": existing["recorded"] if existing else recorded,
+        }
+    body = "".join(
+        render_retire_entry(by_slug[slug]) + "\n" for slug in sorted(by_slug)
+    )
+    path.write_text(header + "\n" + body, encoding="utf-8")
+
