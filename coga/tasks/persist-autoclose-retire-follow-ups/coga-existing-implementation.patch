+def _make_recurring_sweep(
+    repo: Path, monkeypatch: pytest.MonkeyPatch, *, template: str = "autoclose-merged"
+) -> tuple[str, Path, Path]:
+    """Stage a merged ticket swept by a recurring *period* task.
+
+    Mirrors the real shape: the template directory under `coga/recurring/`
+    survives every period, while the period task under `coga/tasks/recurring/`
+    is deleted at the next boundary.
+    """
+    slug, _ = _make_task(
+        repo,
+        on_final=True,
+        pr_url="https://github.com/o/r/pull/24",
+        branch="feature-x",
+        worktree="/tmp/coga-feature-x",
+    )
+    template_dir = repo / "recurring" / template
+    template_dir.mkdir(parents=True)
+    (template_dir / "ticket.md").write_text("template\n")
+    _, period = _make_task(repo, title="Autoclose merged", status="draft")
+    monkeypatch.setenv("COGA_TASK_BLACKBOARD", str(period))
+    monkeypatch.setenv("COGA_TASK_SLUG", f"recurring/{template}")
+    _stub_pr_state(monkeypatch, {"https://github.com/o/r/pull/24": "MERGED"})
+    _capture_posts(monkeypatch)
+    return slug, period, template_dir / am.RETIRE_LIST_FILENAME
+
+
+def test_recipe_records_the_followup_in_the_durable_recurring_worklist(
+    repo: Path, monkeypatch: pytest.MonkeyPatch, capsys: pytest.CaptureFixture[str]
+) -> None:
+    slug, period, worklist = _make_recurring_sweep(repo, monkeypatch)
+
+    assert am.run_autoclose_recipe(load_config(repo), []) == 0
+
+    body = worklist.read_text()
+    assert am.RETIRE_LIST_HEADING in body
+    assert f"- `{slug}` — branch `feature-x`, worktree `/tmp/coga-feature-x`" in body
+    # The period task is deleted at the next boundary, so it must not be the
+    # only place this debt is written.
+    assert am.RETIRE_REPORT_HEADING not in period.read_text()
+    assert am.RETIRE_REPORT_HEADING not in capsys.readouterr().out
+
+
+def test_the_durable_worklist_survives_deleting_the_period_task(
+    repo: Path, monkeypatch: pytest.MonkeyPatch, capsys: pytest.CaptureFixture[str]
+) -> None:
+    slug, period, worklist = _make_recurring_sweep(repo, monkeypatch)
+    assert am.run_autoclose_recipe(load_config(repo), []) == 0
+    capsys.readouterr()
+
+    # What `coga recurring` does at the start of the next period.
+    period.unlink()
+
+    assert not period.exists()
+    assert slug in worklist.read_text()
+
+
+def test_a_second_sweep_does_not_duplicate_a_slug_in_the_worklist(
